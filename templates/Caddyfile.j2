{
{% if caddy_acme_email %}
    email {{ caddy_acme_email }}
{% endif %}
{% if caddy_acme_dns %}
    acme_dns {{ caddy_acme_dns }}
{% endif %}
{% if caddy_metrics_bind %}
    servers {
        metrics
    }
{% endif %}
{% if caddy_global_extra %}
{{ caddy_global_extra | indent(4, first=True) }}
{% endif %}
}

{% for name, body in (caddy_snippets | default({})).items() %}
# Reusable snippet — import with `import {{ name }}` from any site.
({{ name }}) {
{{ body | indent(4, first=True) }}
}

{% endfor %}
{% if caddy_metrics_bind %}
# Prometheus metrics endpoint — restricted to allowed IPs. Addressed as http://
# on purpose: Caddy puts TLS on any site whose address carries a port other
# than 80, which for a bare address here means a certificate for an IP from the
# internal CA, and a scrape target no Prometheus will talk to out of the box.
http://{{ caddy_metrics_bind }}:{{ caddy_metrics_port }} {
    bind {{ caddy_metrics_bind }}
{% if caddy_metrics_allow_ips | length > 0 %}
    @allowed remote_ip {{ caddy_metrics_allow_ips | join(' ') }}
    handle @allowed {
        handle /metrics {
            metrics
        }
    }
    handle {
        respond "Forbidden" 403
    }
{% else %}
    handle /metrics {
        metrics
    }
{% endif %}
}

{% endif %}
{% for site in caddy_sites %}
{{ site.host }} {
{% if site.access_log | default(false) %}
    log {
        output file {{ caddy_log_dir }}/{{ site.host
            | regex_replace('[^A-Za-z0-9._-]', '_') }}.access.log {
            roll_size 100MiB
            roll_keep 7
            roll_keep_for 48h
        }
        format json
    }
{% endif %}
{% if site.allow_ips | default([]) | length > 0 %}
    # Whole-site allowlist, expressed as a deny for everyone else so that
    # everything declared below it — per-path rules, imports, load balancing
    # and health checks — still applies to the clients that are allowed in.
    @not_allowed not remote_ip {{ site.allow_ips | join(' ') }}
    handle @not_allowed {
        respond "Forbidden" 403
    }
{% endif %}
{% for p in site.protected_paths | default([]) %}
{% set idx = loop.index %}
{% set raw_path = p.path %}
{% set base_path = raw_path[:-2] if raw_path.endswith('/*') else (raw_path[:-1] if raw_path.endswith('/') else raw_path) %}
    @protected_{{ idx }} {
        path {{ base_path }} {{ base_path }}/ {{ base_path }}/*
        not remote_ip {{ p.allow_ips | join(' ') }}
    }
    handle @protected_{{ idx }} {
        respond "Forbidden" 403
    }
{% endfor %}
{% for snippet in site.import_snippets | default([]) %}
    import {{ snippet }}
{% endfor %}
{% for file in site.import_files | default([]) %}
    import {{ file }}
{% endfor %}
{% if site.extra_directives is defined %}
{{ site.extra_directives | indent(4, first=True) }}
{% endif %}
{% set request_affinity = site.request_affinity | default({}) %}
{% set request_affinity_enabled = request_affinity.enabled | default(true) | bool if site.request_affinity is defined else false %}
{% set rp_opts = [] %}
{# Load balancing #}
{% if site.lb_policy is defined %}{% set _ = rp_opts.append('lb_policy ' ~ site.lb_policy) %}{% endif %}
{% if site.lb_retries is defined %}{% set _ = rp_opts.append('lb_retries ' ~ site.lb_retries) %}{% endif %}
{% if site.lb_try_duration is defined %}{% set _ = rp_opts.append('lb_try_duration ' ~ site.lb_try_duration) %}{% endif %}
{% if site.lb_try_interval is defined %}{% set _ = rp_opts.append('lb_try_interval ' ~ site.lb_try_interval) %}{% endif %}
{# Active health checks: Caddy polls out of band #}
{% if site.health_uri is defined %}{% set _ = rp_opts.append('health_uri ' ~ site.health_uri) %}{% endif %}
{% if site.health_port is defined %}{% set _ = rp_opts.append('health_port ' ~ site.health_port) %}{% endif %}
{% if site.health_interval is defined %}{% set _ = rp_opts.append('health_interval ' ~ site.health_interval) %}{% endif %}
{% if site.health_timeout is defined %}{% set _ = rp_opts.append('health_timeout ' ~ site.health_timeout) %}{% endif %}
{% if site.health_status is defined %}{% set _ = rp_opts.append('health_status ' ~ site.health_status) %}{% endif %}
{% if site.health_body is defined %}{% set _ = rp_opts.append('health_body ' ~ site.health_body) %}{% endif %}
{# Passive health checks: Caddy judges live request outcomes #}
{% if site.fail_duration is defined %}{% set _ = rp_opts.append('fail_duration ' ~ site.fail_duration) %}{% endif %}
{% if site.max_fails is defined %}{% set _ = rp_opts.append('max_fails ' ~ site.max_fails) %}{% endif %}
{% if site.unhealthy_status is defined %}{% set _ = rp_opts.append('unhealthy_status ' ~ site.unhealthy_status | join(' ')) %}{% endif %}
{% if site.unhealthy_latency is defined %}{% set _ = rp_opts.append('unhealthy_latency ' ~ site.unhealthy_latency) %}{% endif %}
{% if site.unhealthy_request_count is defined %}{% set _ = rp_opts.append('unhealthy_request_count ' ~ site.unhealthy_request_count) %}{% endif %}
{% if request_affinity_enabled %}
{% for rule in request_affinity.rules %}
    @request_affinity_{{ loop.index }} path_regexp {{ rule.name }} {{ rule.pattern }}
{% endfor %}

    # Derive the routing key from the request path. Keep only these header
    # mutations in route: wrapping reverse_proxy here would move it ahead of
    # top-level access denials such as respond directives.
    route {
        request_header -{{ request_affinity.header }}
{% for rule in request_affinity.rules %}
        request_header @request_affinity_{{ loop.index }} {{ request_affinity.header }} {{ '{re.' ~ rule.name ~ '.key}' }}
{% endfor %}
    }
    reverse_proxy {{ site.upstream }} {
{% if request_affinity.fallback_policy != 'random' %}
        lb_policy header {{ request_affinity.header }} {
            fallback {{ request_affinity.fallback_policy }}
        }
{% else %}
        lb_policy header {{ request_affinity.header }}
{% endif %}
{% for opt in rp_opts %}
        {{ opt }}
{% endfor %}
        header_up -{{ request_affinity.header }}
{% if site.upstream_tls_skip_verify | default(false) %}
        transport http {
            tls_insecure_skip_verify
        }
{% endif %}
    }
{% else %}
{% if rp_opts or site.upstream_tls_skip_verify | default(false) %}
    reverse_proxy {{ site.upstream }} {
{% for opt in rp_opts %}
        {{ opt }}
{% endfor %}
{% if site.upstream_tls_skip_verify | default(false) %}
        transport http {
            tls_insecure_skip_verify
        }
{% endif %}
    }
{% else %}
    reverse_proxy {{ site.upstream }}
{% endif %}
{% endif %}
}

{% endfor %}
